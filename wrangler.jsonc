// Static assets + a Worker that runs first for /api/* and /media/*.
// Everything else is served from ./dist via the assets binding.
//
// Generate Env types after changing bindings:
//   npx wrangler types
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "todd-blog",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-31",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api", "/api/*", "/media", "/media/*"]
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "todd-blog-media"
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"GITHUB_REPO": "qiz029/todd-blog",
		"GITHUB_BRANCH": "main"
	},
	"secrets": {
		"required": ["CMS_TOKEN", "GITHUB_TOKEN"]
	}
}
