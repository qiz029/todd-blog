---
const today = new Date();
---

<footer>
  &copy; {today.getFullYear()} Todd Zheng
  <div class="links">
    <a href="/rss.xml">RSS</a>
    <a href="https://github.com/qiz029" target="_blank">GitHub</a>
  </div>
</footer>
<style>
  footer {
    padding: 2em 1em 6em 1em;
    color: rgb(var(--gray));
    text-align: center;
    font-size: 0.9em;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 1.5em;
    margin-top: 0.5em;
  }
  .links a {
    color: rgb(var(--gray));
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
