---
const today = new Date();
const { locale } = Astro.props;
---

<footer>
  <hr />
  <div class="footer-content">
    <span>&copy; {today.getFullYear()} Todd Zheng</span>
    <div class="links">
      <a href="mailto:toddzheng024@gmail.com">Email</a>
      <a href="https://www.linkedin.com/in/toddzheng-024/" target="_blank">LinkedIn</a>
      <a href="https://github.com/qiz029" target="_blank">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>
<style>
  footer {
    padding: 2em 1em 6em 1em;
    max-width: 720px;
    margin: 0 auto;
  }
  footer hr {
    margin-bottom: 1.5em;
  }
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.85em;
  }
  .links {
    display: flex;
    gap: 1.5em;
  }
  .links a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .footer-content {
      flex-direction: column;
      gap: 0.75em;
      text-align: center;
    }
  }
</style>
