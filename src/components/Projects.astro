---
import { Image } from 'astro:assets';
import pluginHubPreview from '../assets/dsh-plugin-hub-preview.png';
import paxPreview from '../assets/paxtech-preview.png';
import roundtablePreview from '../assets/roundtable-preview.png';
import { t } from '../i18n/translations';
import { getRecentRepos } from '../lib/github';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const repos = await getRecentRepos(5);

const featured = [
  {
    name: 'Pax Tech',
    url: 'https://paxtech.net',
    image: paxPreview,
    descKey: 'projects.pax.desc',
  },
  {
    name: 'DSH Plugin Hub',
    url: 'https://dshpluginhub.ai',
    image: pluginHubPreview,
    descKey: 'projects.pluginHub.desc',
  },
  {
    name: 'Roundtable',
    url: 'https://roundtable.toddzheng.com',
    image: roundtablePreview,
    descKey: 'projects.roundtable.desc',
  },
];

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<h2 class="animate-in">{t('projects.featured', locale)}</h2>
<div class="featured-grid">
  {
    featured.map((project, i) => (
      <a
        class="featured-card animate-in"
        style={`animation-delay: ${0.1 + i * 0.08}s`}
        href={project.url}
        target="_blank"
        rel="noopener"
      >
        <Image
          src={project.image}
          alt={`${project.name} preview`}
          class="featured-img"
          width={800}
        />
        <div class="featured-body">
          <div class="featured-head">
            <span class="featured-name">{project.name}</span>
            <span class="featured-url">{project.url.replace('https://', '')}</span>
          </div>
          <p class="featured-desc">{t(project.descKey, locale)}</p>
        </div>
      </a>
    ))
  }
</div>

<hr />

<h2 class="animate-in" style="animation-delay: 0.2s">{t('projects.recent', locale)}</h2>
{
  repos.length > 0 ? (
    <ul class="repo-list">
      {repos.map((repo, i) => (
        <li class="repo animate-in" style={`animation-delay: ${0.3 + i * 0.06}s`}>
          <div class="repo-main">
            <a href={repo.url} target="_blank" rel="noopener" class="repo-name">
              {repo.name}
            </a>
            {repo.description && <span class="repo-desc">{repo.description}</span>}
          </div>
          <div class="repo-meta">
            {repo.language && <span>{repo.language}</span>}
            <span>★ {repo.stars}</span>
            {repo.weeklyCommits > 0 && (
              <span>{t('projects.weekly', locale).replace('{n}', String(repo.weeklyCommits))}</span>
            )}
            <span>
              {t('projects.updated', locale)} {formatDate(repo.pushedAt)}
            </span>
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p set:html={t('projects.fallback', locale)} />
  )
}

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25em;
  }
  @media (max-width: 760px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
  .featured-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: background 0.15s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .featured-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .featured-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border-radius: 0;
    border-bottom: 1px solid var(--border);
  }
  .featured-body {
    padding: 1em 1.25em 1.25em;
  }
  .featured-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75em;
  }
  .featured-name {
    font-weight: 700;
    font-size: 1.15em;
    color: var(--text);
  }
  .featured-url {
    font-size: 0.8em;
    color: var(--text-muted);
  }
  .featured-desc {
    margin: 0.5em 0 0 0;
    font-size: 0.9em;
    color: var(--text-muted);
  }
  hr {
    margin: 2.5em 0;
    border: none;
    border-top: 1px solid var(--border);
  }
  .repo-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .repo {
    padding: 0.75em 0;
    border-bottom: 1px solid var(--border);
  }
  .repo:last-child {
    border-bottom: none;
  }
  .repo-main {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    flex-wrap: wrap;
  }
  .repo-name {
    font-weight: 700;
  }
  .repo-desc {
    font-size: 0.85em;
    color: var(--text-muted);
  }
  .repo-meta {
    display: flex;
    gap: 1.25em;
    margin-top: 0.25em;
    font-size: 0.75em;
    color: var(--text-muted);
    font-family: var(--font-jetbrains), monospace;
  }
</style>
