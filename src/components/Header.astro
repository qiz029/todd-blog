---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_TITLE } from '../consts';
import { t } from '../i18n/translations';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = Astro.currentLocale || 'en';
---

<header>
  <nav>
    <h2>
      <a href={getRelativeLocaleUrl(locale, '/')} class="brand">
        <span class="brand-bold">Todd</span><span class="brand-light">Talk</span>
      </a>
    </h2>
    <div class="internal-links">
      <HeaderLink href={getRelativeLocaleUrl(locale, '/')}>{t('nav.home', locale)}</HeaderLink>
      <HeaderLink href={getRelativeLocaleUrl(locale, '/blog')}>{t('nav.blog', locale)}</HeaderLink>
      <HeaderLink href={getRelativeLocaleUrl(locale, '/about')}>{t('nav.about', locale)}</HeaderLink>
      <LanguageSwitcher />
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }
  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  .brand {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-size: 1.15em;
  }
  .brand-bold {
    font-weight: 900;
    color: #E62B1E;
  }
  .brand-light {
    font-weight: 300;
    color: var(--text);
  }
  .brand:hover .brand-bold {
    color: #cc2418;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  nav a:hover {
    color: var(--text);
  }
</style>
