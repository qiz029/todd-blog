---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_TITLE } from '../consts';
import { t } from '../i18n/translations';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = Astro.currentLocale || 'en';
---

<header>
  <nav>
    <h2>
      <a href={getRelativeLocaleUrl(locale, '/')} class="brand">
        <span class="brand-bold">Todd</span><span class="brand-light">Talk</span>
      </a>
    </h2>
    <div class="internal-links">
      <HeaderLink href={getRelativeLocaleUrl(locale, '/')}>{t('nav.home', locale)}</HeaderLink>
      <HeaderLink href={getRelativeLocaleUrl(locale, '/blog')}>{t('nav.blog', locale)}</HeaderLink>
      <HeaderLink href={getRelativeLocaleUrl(locale, '/projects')}>{t('nav.projects', locale)}</HeaderLink>
      <HeaderLink href={getRelativeLocaleUrl(locale, '/about')}>{t('nav.about', locale)}</HeaderLink>
      <a class="rss-link" href={`/${locale}/rss.xml`} type="application/rss+xml">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="5" cy="19" r="1" fill="currentColor" /><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /></svg>
        {t('rss.link', locale)}
      </a>
      <LanguageSwitcher />
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }
  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  .brand {
    font-family: var(--font-space-grotesk);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-size: 1.15em;
  }
  .brand-bold {
    font-weight: 900;
    color: #E62B1E;
  }
  .brand-light {
    font-weight: 300;
    color: var(--text);
  }
  .brand:hover .brand-bold {
    color: #cc2418;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .internal-links { display: flex; align-items: center; flex-wrap: wrap; }
  nav .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--accent-amber);
    font-size: 0.85em;
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    nav { padding-top: 0.75em; }
    .internal-links { width: 100%; justify-content: space-between; font-size: 0.85em; }
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.25s ease;
  }
  nav a.active {
    text-decoration: none;
    color: var(--text);
    border-bottom-color: var(--accent);
  }
  nav a:hover {
    color: var(--text);
    border-bottom-color: var(--accent);
  }
</style>
