---
/** Original typographic covers: inline vectors stay crisp, light, and independent of remote media. */
interface Props { variant: 'agents' | 'archive' | 'rigor'; portrait?: boolean; }
const { variant, portrait = false } = Astro.props;
---
<div class:list={['editorial-cover', variant]} aria-hidden="true">
  <svg viewBox={portrait ? "0 0 400 520" : "0 0 800 480"} fill="none" xmlns="http://www.w3.org/2000/svg">
    {portrait && variant === 'archive' ? <>
      <path fill="#ded5bd" d="M0 0h400v520H0z" />
      <g stroke="#343b30" opacity=".14"><path d="M30 0v520M370 0v520M0 30h400M0 490h400M0 210h400" /></g>
      <text x="31" y="73" fill="#343b30" font-family="monospace" font-size="13" letter-spacing="2">HISTORY FILES / 01</text>
      <g fill="#30362d" font-family="Georgia, serif" font-size="44"><text x="30" y="132">Dotcom</text><text x="30" y="180">Chronicles.</text></g>
      <path d="M31 249h277v181H31z" fill="#f2ecdc" stroke="#343b30" stroke-width="2" /><path d="M31 275h277" stroke="#343b30" stroke-width="2" />
      <text x="46" y="313" fill="#30362d" font-family="Georgia, serif" font-size="25">World Wide Web</text>
      <path d="M46 336h194M46 350h157M46 383h92m-92 6h92" stroke="#857d65" stroke-width="2" />
      <circle cx="300" cy="401" r="65" fill="#b83124" /><g stroke="#f2ecdc"><ellipse cx="300" cy="401" rx="30" ry="65" /><path d="M235 401h130M245 368h110M245 434h110M300 336v130" /></g>
      <text x="31" y="477" fill="#343b30" font-family="monospace" font-size="16" letter-spacing="2">EST. 1989</text>
    </> : portrait && variant === 'rigor' ? <>
      <path fill="#223c62" d="M0 0h400v520H0z" />
      <g stroke="#bbd2dd" opacity=".22"><path d="M30 30h340v460H30zM0 260h400M200 0v520M0 390h400" /></g>
      <text x="30" y="73" fill="#d0d8e1" font-family="monospace" font-size="13" letter-spacing="2">THINKING / 02</text>
      <g fill="#eeeadd" font-family="var(--font-space-grotesk), sans-serif" font-weight="700" font-size="58" letter-spacing="-3"><text x="29" y="142">STAY</text><text x="29" y="205">CURIOUS.</text></g>
      <g stroke="#e7e5d6" stroke-width="1.5"><circle cx="220" cy="347" r="103" /><circle cx="220" cy="347" r="65" stroke-dasharray="3 8" /><path d="M90 347h260M220 218v258m-77-52 154-154" /></g>
      <circle cx="255" cy="312" r="9" fill="#f0c040" />
      <text x="30" y="482" fill="#d0d8e1" font-family="monospace" font-size="11" letter-spacing="1">RIGOR × AMATEUR SPIRIT</text>
    </> : variant === 'agents' ? <>
      <path fill="#c92820" d="M0 0h800v480H0z" />
      <g stroke="#fff" opacity=".12"><path d="M40 0v480M760 0v480M0 40h800M0 440h800M560 0v480" /></g>
      <g fill="#fff3e6" font-family="var(--font-space-grotesk), sans-serif" font-weight="700" font-size="90" letter-spacing="-5">
        <text x="40" y="143">THE UPDATE</text><text x="40" y="234">PROBLEM.</text>
      </g>
      <g font-family="var(--font-jetbrains), monospace" font-size="17" fill="#fff3e6">
        <text x="43" y="76" font-size="13" letter-spacing="3">AGENT TOOLING / FIELD NOTES</text>
        <text x="63" y="332">CLI v1</text><text x="267" y="332">CLI v2</text><text x="471" y="332">CLI v3</text>
        <text x="61" y="405" font-size="14">WHO OWNS THE NEXT UPDATE?</text>
      </g>
      <g stroke="#fff3e6" stroke-width="2"><path d="M42 290h160v66H42zM246 290h160v66H246zM450 290h160v66H450zM202 323h44M406 323h44M610 323h100m-18-10 18 10-18 10" /><path d="M640 380h100v42H640z" /></g>
      <text x="658" y="408" fill="#fff3e6" font-family="monospace" font-size="18">$ _</text>
    </> : variant === 'archive' ? <>
      <path fill="#ded5bd" d="M0 0h800v480H0z" />
      <g stroke="#272d29" opacity=".15"><path d="M0 80h800M0 160h800M0 240h800M0 320h800M0 400h800M80 0v480M160 0v480M240 0v480M320 0v480M400 0v480M480 0v480M560 0v480M640 0v480M720 0v480" /></g>
      <text x="42" y="57" fill="#353b31" font-family="monospace" font-size="15" letter-spacing="3">THE DOTCOM CHRONICLES</text>
      <path d="M80 100h430v272H80z" fill="#aaa38e" stroke="#282e29" stroke-width="2" />
      <path d="M56 122h430v272H56z" fill="#f2ecdc" stroke="#282e29" stroke-width="2" />
      <path d="M56 160h430M75 140h12m9 0h12m9 0h12" stroke="#282e29" stroke-width="2" />
      <text x="80" y="224" fill="#282e29" font-family="Georgia, serif" font-size="40">World Wide Web</text>
      <path d="M81 252h285M81 267h345M81 282h245" stroke="#777d6c" stroke-width="3" />
      <path d="M81 323h140m-140 7h140M81 352h192m-192 7h192" stroke="#943427" stroke-width="2" />
      <circle cx="599" cy="292" r="122" fill="#b83124" />
      <g stroke="#f2ecdc" stroke-width="1.5"><ellipse cx="599" cy="292" rx="60" ry="122" /><path d="M477 292h244M495 230h208M495 354h208M599 170v244" /></g>
      <text x="511" y="450" fill="#353b31" font-family="monospace" font-size="18" letter-spacing="5">EST. 1989</text>
    </> : <>
      <path fill="#223c62" d="M0 0h800v480H0z" />
      <g stroke="#bbd2dd" opacity=".25"><path d="M40 40h720v400H40zM40 240h720M400 40v400M40 140h720M40 340h720M200 40v400M600 40v400" /></g>
      <circle cx="567" cy="239" r="140" stroke="#e7e5d6" stroke-width="2" />
      <circle cx="567" cy="239" r="94" stroke="#e7e5d6" stroke-width="2" stroke-dasharray="4 9" />
      <path d="m460 350 214-220M567 80v318M408 239h318" stroke="#e7e5d6" stroke-width="2" />
      <circle cx="615" cy="190" r="11" fill="#f0c040" />
      <g fill="#eeeadd" font-family="var(--font-space-grotesk), sans-serif" font-weight="700" font-size="74" letter-spacing="-3"><text x="70" y="170">STAY</text><text x="70" y="252">CURIOUS.</text></g>
      <g fill="#d0d8e1" font-family="monospace" font-size="15" letter-spacing="2"><text x="70" y="80">THINKING / FIRST PRINCIPLES</text><text x="70" y="399">RIGOR × AMATEUR SPIRIT</text></g>
    </>}
  </svg>
</div>
<style>
  .editorial-cover { overflow: hidden; width: 100%; background: #c92820; }
  .archive { background: #ded5bd; }
  .rigor { background: #223c62; }
  svg { display: block; width: 100%; height: auto; transition: transform .4s ease; }
  :global(a:hover) .editorial-cover svg { transform: scale(1.025); }
  @media (prefers-reduced-motion: reduce) { svg { transition: none; } :global(a:hover) .editorial-cover svg { transform: none; } }
</style>
