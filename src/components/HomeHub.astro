---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { FEATURED_PROJECTS } from '../data/featuredProjects';
import { t } from '../i18n/translations';
import { localePosts, localeSeries, postUrl, readingStats, seriesPosts } from '../lib/blog';
import EditorialCover from './EditorialCover.astro';
import FormattedDate from './FormattedDate.astro';

interface Props { locale: string; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const posts = localePosts(await getCollection('blog'), locale);
const feature = posts.find(p => p.id === `${locale}/skill-cli-considered-harmful`);
const essay = posts.find(p => p.id === `${locale}/scientific-discipline-amateur-spirit`);
const archive = localeSeries(await getCollection('series'), locale).find(s => s.id === `${locale}/dotcom-chronicles`);
const archivePosts = seriesPosts(posts, 'dotcom-chronicles');
const archiveHref = `/${locale}/series/dotcom-chronicles/`;
const minutes = (body: string | undefined) => `${readingStats(body ?? '').minutes} ${zh ? '分钟阅读' : 'min read'}`;
---

<div class="editorial-home">
  <section class="masthead animate-in" aria-labelledby="home-title">
    <div>
      <p class="eyebrow"><span class="red-square" aria-hidden="true"></span>{t('home.role', locale)}</p>
      <h1 id="home-title">Todd Zheng<span class="title-dot">.</span></h1>
    </div>
    <div class="intro">
      <p>{zh ? '构建软件，记录思考。探索技术如何改变我们工作与生活的方式。' : 'Building software. Thinking out loud. Exploring how technology changes the way we work and live.'}</p>
      <a href={`/${locale}/about/`}>{zh ? '关于我' : 'About me'} <span aria-hidden="true">↗</span></a>
      <a href="mailto:toddzheng024@gmail.com">{t('home.cta.contact', locale)} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="selected" aria-labelledby="selected-title">
    <div class="section-rule"><h2 id="selected-title">{zh ? '本期精选' : 'Selected reading'}</h2><span>01 / EDITOR’S PICKS</span></div>
    <div class="editorial-grid">
      {feature && <article class="lead-story">
        <a href={postUrl(feature, locale)} class="story-link">
          <EditorialCover variant="agents" />
          <div class="story-copy">
            <p class="eyebrow">{zh ? 'AI 工程 · 观点' : 'AI ENGINEERING · OPINION'}<span>{minutes(feature.body)}</span></p>
            <h3>{feature.data.title}</h3>
            <p class="dek">{zh ? '给 Agent 一个 CLI 很容易。但下一次版本更新，该由谁来负责？' : 'Giving an agent a CLI is easy. But who takes responsibility for the next version?'} </p>
            <span class="read-link">{zh ? '阅读全文' : 'Read the essay'} <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </article>}
      <div class="side-stories">
        {archive && archivePosts.length > 0 && <article class="side-story">
          <a href={archiveHref} class="story-link">
            <div class="small-cover"><EditorialCover variant="archive" portrait /></div>
            <div class="story-copy">
              <p class="eyebrow">{zh ? '互联网历史 · 连载' : 'INTERNET HISTORY · SERIES'}</p>
              <h3>{archive.data.title}</h3>
              <p class="dek">{zh ? '回到互联网一切尚未确定的年代。' : 'Back to when the internet’s future was still unwritten.'}</p>
              <span class="read-link">{archivePosts.length} {zh ? '篇文章 · 进入专题' : 'essays · Explore the archive'} <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </article>}
        {essay && <article class="side-story">
          <a href={postUrl(essay, locale)} class="story-link">
            <div class="small-cover"><EditorialCover variant="rigor" portrait /></div>
            <div class="story-copy">
              <p class="eyebrow">{zh ? '独立思考 · 随笔' : 'INDEPENDENT THINKING · ESSAY'}</p>
              <h3>{essay.data.title}</h3>
              <span class="read-link">{minutes(essay.body)} <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        </article>}
      </div>
    </div>
  </section>

  <section class="latest" aria-labelledby="latest-title">
    <div class="section-rule"><h2 id="latest-title">{zh ? '最近写作' : 'Latest dispatches'}</h2><a href={`/${locale}/blog/`}>{t('home.allWriting', locale)} <span aria-hidden="true">↗</span></a></div>
    <ol class="dispatches">
      {posts.slice(0, 4).map((post, i) => <li>
        <a href={postUrl(post, locale)}>
          <span class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
          <span class="dispatch-meta"><FormattedDate date={post.data.pubDate} /><span>{minutes(post.body)}</span></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>)}
    </ol>
  </section>

  {archive && archivePosts.length > 0 && <aside class="archive-invitation">
    <div class="archive-year" aria-hidden="true">1989<span>→ 2004</span></div>
    <div><p class="eyebrow">{zh ? '一项持续更新的历史写作计划' : 'AN ONGOING HISTORY PROJECT'}</p><h2>{zh ? '理解下一次浪潮，\n先回看上一次。' : 'The next wave has\na history.'}</h2><p>{zh ? '从一份 CERN 提案出发，沿着人物、文档与技术选择，重走互联网成为日常的路。' : 'Starting with a proposal at CERN, follow the people, documents, and technical choices that made the internet part of everyday life.'}</p><a href={archiveHref}>{zh ? '打开 Dotcom 编年史' : 'Open The Dotcom Chronicles'} <span aria-hidden="true">↗</span></a></div>
  </aside>}

  <section class="building" aria-labelledby="building-title">
    <div class="section-rule"><h2 id="building-title">{t('home.building', locale)}</h2><a href={`/${locale}/projects/`}>{t('home.allProjects', locale)} <span aria-hidden="true">↗</span></a></div>
    <p class="section-intro">{t('home.building.intro', locale)}</p>
    <div class="product-grid">
      {FEATURED_PROJECTS.map((product) => <a class="product-card" href={product.url} target="_blank" rel="noopener">
        <Image src={product.image} alt="" width={600} loading="lazy" />
        <div class="product-body"><h3>{product.name}<span aria-hidden="true"> ↗</span></h3><p>{t(product.descKey, locale)}</p></div>
      </a>)}
    </div>
  </section>
</div>

<style>
  .editorial-home { --editorial-muted: #a4adba; }
  .masthead { display: grid; grid-template-columns: 1.05fr 1fr; gap: 3em; align-items: center; padding: .5em 0 2.5em; }
  .eyebrow { display: flex; align-items: center; flex-wrap: wrap; gap: .65em; font: 500 .64rem/1.6 var(--font-jetbrains), monospace; letter-spacing: .09em; text-transform: uppercase; margin: 0 0 .85em; color: var(--editorial-muted); }
  .red-square { display: inline-block; width: 7px; height: 7px; background: var(--accent); }
  .masthead h1 { font-size: clamp(2.4rem, 5vw, 4.2rem); letter-spacing: -.065em; margin: 0; }
  .title-dot { color: var(--accent); }
  .intro p { font-size: .94em; color: #bdc4ce; line-height: 1.7; margin: 0 0 .55em; max-width: 460px; }
  .intro a { font-size: .74em; color: var(--text); margin-right: 1.5em; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: #58616d; }
  .section-rule { border-top: 1px solid #626975; display: flex; justify-content: space-between; align-items: baseline; gap: 1em; padding: .8em 0 1.1em; }
  .section-rule h2 { font-size: .76em; letter-spacing: .02em; margin: 0; }
  .section-rule > span, .section-rule > a { font: .59rem/1.6 var(--font-jetbrains), monospace; color: var(--editorial-muted); }
  .section-rule > a { font-size: .72rem; }
  .editorial-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 2em; }
  .story-link { display: block; color: var(--text); height: 100%; }
  .story-link:hover { color: var(--text); }
  .lead-story { border-bottom: 1px solid var(--border); }
  .story-copy { padding: 1.15em 0 1.4em; }
  .story-copy .eyebrow { color: #bdc4ce; }
  .story-copy .eyebrow span { margin-left: auto; letter-spacing: 0; color: var(--editorial-muted); }
  .lead-story h3 { font-size: clamp(1.55rem, 2.5vw, 2.1rem); letter-spacing: -.03em; line-height: 1.24; max-width: 610px; }
  .dek { font-size: .84em; line-height: 1.7; color: var(--editorial-muted); margin: .7em 0 1.1em; }
  .read-link { display: inline-flex; align-items: center; gap: .9em; font: .69rem/1.6 var(--font-jetbrains), monospace; color: #eeaea2; }
  .read-link > span { font-size: 1rem; transition: transform .2s ease; }
  .story-link:hover .read-link > span { transform: translate(2px, -2px); }
  .side-stories { display: grid; grid-template-rows: 1fr 1fr; gap: 1.3em; }
  .side-story { border-bottom: 1px solid var(--border); }
  .side-story .story-link { display: grid; grid-template-columns: 1fr 1.15fr; align-items: start; gap: 1em; }
  .side-story .story-copy { padding: 0 0 1em; }
  .side-story h3 { font-size: 1.13em; line-height: 1.4; }
  .side-story .dek { font-size: .74em; }
  .side-story .eyebrow { font-size: .58rem; }
  .small-cover { padding-top: .15em; }

  .latest, .building { margin-top: 3.5em; }
  .dispatches { list-style: none; padding: 0; margin: 0; }
  .dispatches li { border-bottom: 1px solid var(--border); }
  .dispatches a { display: grid; grid-template-columns: 2em minmax(0, 1fr) 125px 1em; gap: 1em; align-items: start; padding: 1.35em 0; color: var(--text); }
  .index { font: .75rem/1.8 var(--font-jetbrains), monospace; color: #cf8b80; }
  .dispatches h3 { font-size: 1em; line-height: 1.5; }
  .dispatches p { font-size: .75em; line-height: 1.6; color: var(--editorial-muted); margin: .5em 0 0; max-width: 680px; }
  .dispatch-meta { font: .6rem/1.8 var(--font-jetbrains), monospace; color: var(--editorial-muted); text-align: right; }
  .dispatch-meta > span { display: block; margin-top: .3em; }
  .arrow { color: #b5becb; }
  .dispatches a:hover h3 { color: #f1b5a9; }
  .archive-invitation { margin-top: 3.5em; padding: 2.6em; display: grid; grid-template-columns: 1fr 1.35fr; gap: 3em; align-items: center; border-top: 3px solid #c7392c; background: #ddd5c0; color: #343a32; }
  .archive-year { font: 7rem/.9 Georgia, serif; letter-spacing: -.06em; border-right: 1px solid #a6a18f; }
  .archive-year span { display: block; font: .9rem/1.5 var(--font-jetbrains), monospace; letter-spacing: .1em; margin: 1.5em 0 0 .35em; }
  .archive-invitation .eyebrow { color: #4c5347; }
  .archive-invitation h2 { font: 2.25rem/1.15 Georgia, 'Songti SC', serif; color: #292e28; white-space: pre-line; letter-spacing: -.03em; }
  .archive-invitation p:not(.eyebrow) { font-size: .8em; line-height: 1.75; }
  .archive-invitation a { color: #8e2b21; font-size: .75em; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
  .section-intro { font-size: .85em; color: var(--editorial-muted); margin: 0 0 1.5em; }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5em; }
  .product-card { color: var(--text); border-bottom: 1px solid var(--border); }
  .product-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border-radius: 0; filter: saturate(.7); transition: filter .2s; }
  .product-card:hover img { filter: saturate(1); }
  .product-body { padding: 1em 0; }
  .product-body h3 { font-size: .95em; }
  .product-body h3 span { float: right; color: #eeaea2; }
  .product-body p { font-size: .76em; color: var(--editorial-muted); margin: .65em 0 0; }
  a:focus-visible { outline: 2px solid var(--accent-amber); outline-offset: 6px; }
  @media (max-width: 1000px) and (min-width: 721px) {
    .editorial-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1.4em; }
    .side-story .story-link { grid-template-columns: 80px minmax(0, 1fr); gap: .8em; }
    .side-story h3 { font-size: 1em; }
    .side-story .dek { display: none; }
    .archive-year { font-size: 5rem; }
  }
  @media (max-width: 720px) {
    .masthead { grid-template-columns: 1fr; gap: .85em; padding: .5em 0 1.8em; }
    .masthead h1 { font-size: 2.8rem; }
    .intro p { font-size: .82em; margin-bottom: .65em; }
    .eyebrow { font-size: .6rem; }
    .editorial-grid { grid-template-columns: 1fr; gap: 1.5em; }
    .lead-story h3 { font-size: 1.6rem; }
    .story-copy { padding: 1em 0 1.25em; }
    .side-stories { gap: 1.2em; }
    .side-story .story-link { grid-template-columns: minmax(0, .85fr) minmax(0, 1.3fr); }

    .side-story h3 { font-size: 1.08em; }
    .latest, .building { margin-top: 2.5em; }
    .dispatches a { grid-template-columns: 1.5em minmax(0, 1fr) 1em; gap: .6em; padding: 1.1em 0; }
    .dispatch-meta { grid-column: 2; grid-row: 2; display: flex; flex-wrap: wrap; gap: 1em; text-align: left; }
    .dispatch-meta > span { margin: 0; }
    .arrow { grid-column: 3; grid-row: 1; }
    .dispatches p { display: none; }
    .archive-invitation { grid-template-columns: 1fr; gap: 1.6em; padding: 1.5em; margin-top: 2.5em; }
    .archive-year { font-size: 4.5rem; border-right: 0; border-bottom: 1px solid #a6a18f; padding-bottom: .3em; display: flex; align-items: baseline; gap: .2em; }
    .archive-year span { margin: 0; font-size: .7rem; letter-spacing: 0; }
    .archive-invitation h2 { font-size: 1.9rem; }
    .product-grid { grid-template-columns: 1fr; gap: 1.4em; }
    .product-card { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 1em; }
    .product-body { padding: 0 0 1em; }
    .product-body h3 { line-height: 1.6; }
  }
  @media (prefers-reduced-motion: reduce) { .read-link > span, .product-card img { transition: none; } .story-link:hover .read-link > span { transform: none; } }
</style>
