---
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLocale = Astro.currentLocale || 'en';
const otherLocale = currentLocale === 'en' ? 'zh' : 'en';

// Build the URL for the other locale using the current path.
// Strip the current locale prefix, prepend the other locale.
const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(new RegExp(`^/${currentLocale}(/|$)`), '/$1').replace(/\/$/, '') || '/';
// Pages without a locale twin: the 404 goes to the other home page, and a single tag
// page (tags differ per language) goes to the other locale's tag index.
const targetPath =
  pathWithoutLocale === '/' || pathWithoutLocale === '/404'
    ? ''
    : /^\/+tags\/[^/]+$/.test(pathWithoutLocale)
      ? 'tags'
      : pathWithoutLocale.replace(/^\//, '');
const otherUrl = getRelativeLocaleUrl(otherLocale, targetPath);
---

<a href={otherUrl} class="lang-switch" title={currentLocale === 'en' ? '切换到中文' : 'Switch to English'}>
  {currentLocale === 'en' ? '中文' : 'EN'}
</a>

<style>
  .lang-switch {
    font-size: 0.85em;
    padding: 0.3em 0.6em;
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }
  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
