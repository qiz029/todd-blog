---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_PROFILE_URLS, X_HANDLE } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata | string;
	// Set for blog posts: switches og:type to article and emits BlogPosting JSON-LD.
	article?: {
		pubDate: Date;
		updatedDate?: Date;
		tags?: string[];
	};
	// Profile pages identify the author as their main entity.
	pageType?: 'website' | 'profile';
	// Disable hreflang alternates on pages that don't exist in the other locale (e.g. tag pages).
	alternates?: boolean;
}

const locale = Astro.currentLocale || 'en';
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// hreflang alternates: same path with the locale prefix swapped.
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(en|zh)(?=\/|$)/, '');
const localeURL = (l: string) => new URL(`/${l}${pathWithoutLocale}`, Astro.site);

const {
	title,
	description = SITE_DESCRIPTION,
	image = FallbackImage,
	article,
	pageType = 'website',
	alternates = true,
} = Astro.props;

const imageURL = new URL(typeof image === 'string' ? image : image.src, Astro.site);
const language = locale === 'zh' ? 'zh-CN' : 'en-US';
const siteURL = Astro.site?.toString();
const personId = new URL('/#person', Astro.site).toString();
const websiteId = new URL('/#website', Astro.site).toString();

const person = {
	'@type': 'Person',
	'@id': personId,
	name: AUTHOR_NAME,
	alternateName: '郑秋石',
	url: new URL('/en/about/', Astro.site).toString(),
	description: SITE_DESCRIPTION,
	sameAs: SOCIAL_PROFILE_URLS,
	knowsAbout: [
		'AI agents',
		'Developer tools',
		'Release engineering',
		'Distributed systems',
		'Developer experience',
	],
};

const website = {
	'@type': 'WebSite',
	'@id': websiteId,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: siteURL,
	author: { '@id': personId },
	publisher: { '@id': personId },
};

const primaryEntity = article
	? {
			'@type': 'BlogPosting',
			'@id': `${canonicalURL.toString()}#article`,
			headline: title,
			description,
			url: canonicalURL.toString(),
			mainEntityOfPage: canonicalURL.toString(),
			image: imageURL.toString(),
			datePublished: article.pubDate.toISOString(),
			dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
			keywords: article.tags?.join(', '),
			inLanguage: language,
			author: { '@id': personId },
			isPartOf: { '@id': websiteId },
		}
	: pageType === 'profile'
		? {
				'@type': 'ProfilePage',
				'@id': `${canonicalURL.toString()}#profile`,
				name: title,
				description,
				url: canonicalURL.toString(),
				inLanguage: language,
				mainEntity: { '@id': personId },
				isPartOf: { '@id': websiteId },
			}
		: website;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': primaryEntity === website ? [website, person] : [primaryEntity, website, person],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} (English)`}
	href={new URL('en/rss.xml', Astro.site)}
/>
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} (中文)`}
	href={new URL('zh/rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-space-grotesk" preload />
<Font cssVariable="--font-jetbrains" />

<!-- Smooth fade transitions between pages -->
<ClientRouter />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{
	alternates && (
		<>
			<link rel="alternate" hreflang="en" href={localeURL('en')} />
			<link rel="alternate" hreflang="zh-CN" href={localeURL('zh')} />
			<link rel="alternate" hreflang="x-default" href={localeURL('en')} />
		</>
	)
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={AUTHOR_NAME} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
{
	article && (
		<>
			<meta property="article:published_time" content={article.pubDate.toISOString()} />
			{article.updatedDate && (
				<meta property="article:modified_time" content={article.updatedDate.toISOString()} />
			)}
			<meta property="article:author" content={AUTHOR_NAME} />
			{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		</>
	)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:creator" content={X_HANDLE} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
