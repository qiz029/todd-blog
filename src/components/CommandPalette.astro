---
import { getCollection } from 'astro:content';
import { BILIBILI_GO } from '../consts';
import { t } from '../i18n/translations';

const locale = Astro.currentLocale || 'en';
const otherLocale = locale === 'zh' ? 'en' : 'zh';

const posts = await getCollection('blog', (entry) => entry.id.startsWith(`${locale}/`) && !entry.data.draft);
// Search metadata for every published post without shipping full article bodies.
const recentPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pages = [
  { group: t('palette.group.pages', locale), title: t('nav.home', locale), url: `/${locale}/` },
  { group: t('palette.group.pages', locale), title: t('nav.blog', locale), url: `/${locale}/blog/` },
  { group: t('palette.group.pages', locale), title: t('nav.projects', locale), url: `/${locale}/projects/` },
  { group: t('palette.group.pages', locale), title: t('nav.series', locale), url: `/${locale}/series/` },
  { group: t('palette.group.pages', locale), title: t('tags.heading', locale), url: `/${locale}/tags/` },
  { group: t('palette.group.pages', locale), title: t('nav.about', locale), url: `/${locale}/about/` },
  // A tracked redirect, not a page: opened with a full navigation.
  { group: t('palette.group.pages', locale), title: t('bilibili.palette', locale), url: BILIBILI_GO, external: true },
  { group: t('palette.group.pages', locale), title: t('palette.lang', locale), url: `/${otherLocale}/` },
];

const items = [
  ...pages,
  ...recentPosts.map((post) => ({
    group: t('palette.group.posts', locale),
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
    url: `/${locale}/blog/${post.id.slice(locale.length + 1)}/`,
  })),
];

const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
---

<div class="palette" id="palette" role="dialog" aria-modal="true" aria-label={t('palette.trigger', locale)} hidden>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-box">
    <div class="palette-input-row">
      <span class="palette-prompt">~ $</span>
      <input
        id="palette-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        placeholder={t('palette.placeholder', locale)}
        autocomplete="off"
        spellcheck="false"
        aria-label={t('palette.trigger', locale)}
      />
      <button type="button" class="palette-close" data-palette-close aria-label={t('palette.hint.close', locale)}>×</button>
    </div>
    <ul class="palette-list" id="palette-list" role="listbox" aria-label={t('palette.trigger', locale)} data-empty={t('palette.empty', locale)}></ul>
    <div class="palette-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t('palette.hint.nav', locale)}</span>
      <span><kbd>↵</kbd> {t('palette.hint.open', locale)}</span>
      <span><kbd>esc</kbd> {t('palette.hint.close', locale)}</span>
    </div>
  </div>
</div>
<script type="application/json" id="palette-data" set:html={itemsJson}></script>

<style>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
  }
  .palette[hidden] { display: none; }
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 8, 12, 0.6);
    backdrop-filter: blur(4px);
    animation: palette-fade 0.15s ease-out both;
  }
  .palette-box {
    position: relative;
    width: 560px;
    max-width: calc(100vw - 2em);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    box-shadow: 0 0 0 1px rgba(230, 43, 30, 0.12), 0 24px 70px rgba(0, 0, 0, 0.6), 0 0 90px rgba(230, 43, 30, 0.07);
    font-family: var(--font-jetbrains), monospace;
    animation: palette-pop 0.16s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .palette-input-row {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.9em 1em;
    border-bottom: 1px solid var(--border);
  }
  .palette-prompt { color: var(--accent); font-size: 0.85em; }
  #palette-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 16px;
    outline: none;
  }
  #palette-input::placeholder { color: var(--text-muted); }
  .palette-close { flex: none; min-width: 44px; min-height: 44px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg); color: var(--text); font-size: 1.4em; cursor: pointer; }
  .palette-close:focus-visible { outline: 2px solid var(--accent-amber); outline-offset: 2px; }
  .palette-list :global(.palette-copy) { min-width: 0; overflow-wrap: anywhere; }
  .palette-list :global(.palette-description) { display: block; color: var(--text-muted); font-size: 0.85em; margin-top: 0.35em; }
  .palette-list :global(.palette-tags) { display: block; color: var(--accent-amber); font-size: 0.8em; margin-top: 0.35em; }
  .palette-list {
    list-style: none;
    margin: 0;
    padding: 0.4em;
    max-height: 320px;
    max-height: min(320px, 50dvh);
    overflow-y: auto;
  }
  .palette-list :global(.palette-group) {
    padding: 0.55em 0.6em 0.25em;
    color: var(--text-muted);
    font-size: 0.66em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .palette-list :global(.palette-item) {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 0.6em;
    border-radius: 6px;
    color: var(--text);
    font-size: 0.82em;
    cursor: pointer;
  }
  .palette-list :global(.palette-item)::before {
    content: '›';
    color: var(--accent-amber);
  }
  .palette-list :global(.palette-item.active) {
    background: var(--bg-card-hover);
    outline: 1px solid rgba(230, 43, 30, 0.35);
  }
  .palette-list :global(.palette-empty) {
    padding: 1.4em 0.6em;
    color: var(--text-muted);
    font-size: 0.8em;
    text-align: center;
  }
  .palette-foot {
    display: flex;
    gap: 1.2em;
    padding: 0.6em 1em;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.66em;
  }
  .palette kbd {
    padding: 0.1em 0.4em;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.9em;
  }
  @keyframes palette-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes palette-pop {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .palette-backdrop, .palette-box { animation: none; }
  }
  @media (max-width: 600px) {
    .palette { padding-top: 3dvh; }
    .palette-foot { display: none; }
    .palette-input-row { padding: 0.5em; gap: 0.4em; }
    .palette-prompt { display: none; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { matchesSearch } from '../lib/search';

  interface PaletteItem { group: string; title: string; url: string; external?: boolean; description?: string; tags?: string[]; }

  let paletteItems: PaletteItem[] = [];
  let matched: PaletteItem[] = [];
  let paletteActive = 0;
  // Element that had focus before the palette opened; focus returns there on close.
  let returnFocus: HTMLElement | null = null;

  const els = () => ({
    palette: document.getElementById('palette'),
    input: document.getElementById('palette-input') as HTMLInputElement | null,
    list: document.getElementById('palette-list'),
  });

  const openPalette = () => {
    const { palette, input } = els();
    if (!palette || !input) return;
    returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    palette.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    renderPalette('');
    input.focus();
  };

  const closePalette = () => {
    const { palette } = els();
    if (!palette || palette.hidden) return;
    palette.hidden = true;
    document.body.style.overflow = '';
    returnFocus?.focus();
    returnFocus = null;
  };

  const openItem = (item: PaletteItem) => {
    closePalette();
    if (item.external) window.location.href = item.url;
    else navigate(item.url);
  };

  const setPaletteActive = (index: number) => {
    const { input, list } = els();
    if (!list) return;
    paletteActive = index;
    list.querySelectorAll('.palette-item').forEach((el, i) => {
      el.classList.toggle('active', i === paletteActive);
      el.setAttribute('aria-selected', String(i === paletteActive));
    });
    input?.setAttribute('aria-activedescendant', `palette-opt-${paletteActive}`);
  };

  const renderPalette = (query: string) => {
    const { input, list } = els();
    if (!list) return;
    matched = paletteItems.filter((item) => matchesSearch(item, query));
    paletteActive = 0;
    list.innerHTML = '';
    if (!matched.length) {
      input?.removeAttribute('aria-activedescendant');
      const empty = document.createElement('li');
      empty.className = 'palette-empty';
      empty.setAttribute('role', 'presentation');
      empty.textContent = list.dataset.empty || '∅';
      list.appendChild(empty);
      return;
    }
    let lastGroup = '';
    matched.forEach((item, i) => {
      if (item.group !== lastGroup) {
        lastGroup = item.group;
        const group = document.createElement('li');
        group.className = 'palette-group';
        group.setAttribute('role', 'presentation');
        group.textContent = item.group;
        list.appendChild(group);
      }
      const li = document.createElement('li');
      li.id = `palette-opt-${i}`;
      li.className = 'palette-item';
      const copy = document.createElement('span');
      copy.className = 'palette-copy';
      const title = document.createElement('span');
      title.textContent = item.title;
      copy.appendChild(title);
      if (query.trim() && item.description) {
        const description = document.createElement('span');
        description.className = 'palette-description';
        description.textContent = item.description;
        copy.appendChild(description);
      }
      if (query.trim() && item.tags?.length) {
        const tags = document.createElement('span');
        tags.className = 'palette-tags';
        tags.textContent = item.tags.map((tag) => `#${tag}`).join(' ');
        copy.appendChild(tags);
      }
      li.appendChild(copy);
      li.setAttribute('role', 'option');
      li.addEventListener('mousemove', () => {
        if (paletteActive !== i) setPaletteActive(i);
      });
      li.addEventListener('click', () => openItem(item));
      list.appendChild(li);
    });
    setPaletteActive(0);
  };

  const movePaletteActive = (delta: number) => {
    const { list } = els();
    if (!list || !matched.length) return;
    const next = (paletteActive + delta + matched.length) % matched.length;
    setPaletteActive(next);
    list.querySelectorAll('.palette-item')[next]?.scrollIntoView({ block: 'nearest' });
  };

  document.addEventListener('astro:page-load', () => {
    const dataEl = document.getElementById('palette-data');
    const { palette, input } = els();
    if (!dataEl || !palette || !input) return;
    try {
      paletteItems = JSON.parse(dataEl.textContent || '[]');
    } catch {
      paletteItems = [];
    }

    input.addEventListener('input', () => renderPalette(input.value));
    input.addEventListener('keydown', (event) => {
      if (event.isComposing) return;
      if (event.key === 'ArrowDown') { event.preventDefault(); movePaletteActive(1); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); movePaletteActive(-1); }
      else if (event.key === 'Enter') {
        const item = matched[paletteActive];
        if (item) { event.preventDefault(); openItem(item); }
      }
    });
    palette.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const close = palette.querySelector<HTMLButtonElement>('.palette-close');
      if (!close) return;
      if (event.shiftKey && document.activeElement === input) { event.preventDefault(); close.focus(); }
      else if (!event.shiftKey && document.activeElement === close) { event.preventDefault(); input.focus(); }
    });
    palette.querySelectorAll('[data-palette-close]').forEach((el) => el.addEventListener('click', closePalette));
    document.querySelectorAll('.palette-trigger').forEach((btn) => {
      btn.addEventListener('click', openPalette);
    });
  });

  if (!(window as any).__paletteGlobalBound) {
    (window as any).__paletteGlobalBound = true;
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        const { palette } = els();
        if (palette && !palette.hidden) closePalette();
        else openPalette();
      } else if (event.key === 'Escape') {
        closePalette();
      }
    });
  }
</script>
