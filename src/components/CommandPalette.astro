---
import { getCollection } from 'astro:content';
import { t } from '../i18n/translations';

const locale = Astro.currentLocale || 'en';
const otherLocale = locale === 'zh' ? 'en' : 'zh';

const posts = await getCollection('blog', (entry) => entry.id.startsWith(`${locale}/`) && !entry.data.draft);
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 12);

const pages = [
  { group: t('palette.group.pages', locale), title: t('nav.home', locale), url: `/${locale}/` },
  { group: t('palette.group.pages', locale), title: t('nav.blog', locale), url: `/${locale}/blog/` },
  { group: t('palette.group.pages', locale), title: t('nav.projects', locale), url: `/${locale}/projects/` },
  { group: t('palette.group.pages', locale), title: t('nav.series', locale), url: `/${locale}/series/` },
  { group: t('palette.group.pages', locale), title: t('tags.heading', locale), url: `/${locale}/tags/` },
  { group: t('palette.group.pages', locale), title: t('nav.about', locale), url: `/${locale}/about/` },
  { group: t('palette.group.pages', locale), title: t('palette.lang', locale), url: `/${otherLocale}/` },
];

const items = [
  ...pages,
  ...recentPosts.map((post) => ({
    group: t('palette.group.posts', locale),
    title: post.data.title,
    url: `/${locale}/blog/${post.id.slice(locale.length + 1)}/`,
  })),
];

const itemsJson = JSON.stringify(items).replace(/</g, '\\u003c');
---

<div class="palette" id="palette" role="dialog" aria-modal="true" aria-label="Command palette" hidden>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-box">
    <div class="palette-input-row">
      <span class="palette-prompt">~ $</span>
      <input
        id="palette-input"
        type="text"
        placeholder={t('palette.placeholder', locale)}
        autocomplete="off"
        spellcheck="false"
        aria-label={t('palette.trigger', locale)}
      />
      <kbd>esc</kbd>
    </div>
    <ul class="palette-list" id="palette-list" role="listbox" data-empty={t('palette.empty', locale)}></ul>
    <div class="palette-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t('palette.hint.nav', locale)}</span>
      <span><kbd>↵</kbd> {t('palette.hint.open', locale)}</span>
      <span><kbd>esc</kbd> {t('palette.hint.close', locale)}</span>
    </div>
  </div>
</div>
<script type="application/json" id="palette-data" set:html={itemsJson}></script>

<style>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 14vh;
  }
  .palette[hidden] { display: none; }
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 8, 12, 0.6);
    backdrop-filter: blur(4px);
    animation: palette-fade 0.15s ease-out both;
  }
  .palette-box {
    position: relative;
    width: 560px;
    max-width: calc(100vw - 2em);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    box-shadow: 0 0 0 1px rgba(230, 43, 30, 0.12), 0 24px 70px rgba(0, 0, 0, 0.6), 0 0 90px rgba(230, 43, 30, 0.07);
    font-family: var(--font-jetbrains), monospace;
    animation: palette-pop 0.16s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .palette-input-row {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.9em 1em;
    border-bottom: 1px solid var(--border);
  }
  .palette-prompt { color: var(--accent); font-size: 0.85em; }
  #palette-input {
    flex: 1;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 0.92em;
    outline: none;
  }
  #palette-input::placeholder { color: var(--text-muted); }
  .palette-list {
    list-style: none;
    margin: 0;
    padding: 0.4em;
    max-height: 320px;
    overflow-y: auto;
  }
  .palette-list :global(.palette-group) {
    padding: 0.55em 0.6em 0.25em;
    color: var(--text-muted);
    font-size: 0.66em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .palette-list :global(.palette-item) {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5em 0.6em;
    border-radius: 6px;
    color: var(--text);
    font-size: 0.82em;
    cursor: pointer;
  }
  .palette-list :global(.palette-item)::before {
    content: '›';
    color: var(--accent-amber);
  }
  .palette-list :global(.palette-item.active) {
    background: var(--bg-card-hover);
    outline: 1px solid rgba(230, 43, 30, 0.35);
  }
  .palette-list :global(.palette-empty) {
    padding: 1.4em 0.6em;
    color: var(--text-muted);
    font-size: 0.8em;
    text-align: center;
  }
  .palette-foot {
    display: flex;
    gap: 1.2em;
    padding: 0.6em 1em;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.66em;
  }
  .palette kbd {
    padding: 0.1em 0.4em;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.9em;
  }
  @keyframes palette-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes palette-pop {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .palette-backdrop, .palette-box { animation: none; }
  }
</style>

<script>
  interface PaletteItem { group: string; title: string; url: string; }

  const openPalette = () => {
    const palette = document.getElementById('palette');
    const input = document.getElementById('palette-input') as HTMLInputElement | null;
    if (!palette || !input) return;
    palette.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    renderPalette('');
    input.focus();
  };

  const closePalette = () => {
    const palette = document.getElementById('palette');
    if (!palette || palette.hidden) return;
    palette.hidden = true;
    document.body.style.overflow = '';
  };

  let paletteItems: PaletteItem[] = [];
  let paletteActive = 0;

  const renderPalette = (query: string) => {
    const list = document.getElementById('palette-list');
    if (!list) return;
    const q = query.trim().toLowerCase();
    const matched = q
      ? paletteItems.filter((item) => item.title.toLowerCase().includes(q))
      : paletteItems;
    paletteActive = 0;
    list.innerHTML = '';
    if (!matched.length) {
      const empty = document.createElement('li');
      empty.className = 'palette-empty';
      empty.textContent = list.dataset.empty || '∅';
      list.appendChild(empty);
      return;
    }
    let lastGroup = '';
    matched.forEach((item, i) => {
      if (item.group !== lastGroup) {
        lastGroup = item.group;
        const group = document.createElement('li');
        group.className = 'palette-group';
        group.textContent = item.group;
        list.appendChild(group);
      }
      const li = document.createElement('li');
      li.className = 'palette-item' + (i === paletteActive ? ' active' : '');
      li.textContent = item.title;
      li.setAttribute('role', 'option');
      li.addEventListener('mousemove', () => setPaletteActive(i));
      li.addEventListener('click', () => { window.location.href = item.url; });
      list.appendChild(li);
    });
    (list as any)._matched = matched;
  };

  const setPaletteActive = (index: number) => {
    const list = document.getElementById('palette-list');
    if (!list) return;
    paletteActive = index;
    list.querySelectorAll('.palette-item').forEach((el, i) => {
      el.classList.toggle('active', i === paletteActive);
    });
  };

  const movePaletteActive = (delta: number) => {
    const list = document.getElementById('palette-list');
    const matched: PaletteItem[] = ((list as any)?._matched) || [];
    if (!matched.length) return;
    const next = (paletteActive + delta + matched.length) % matched.length;
    setPaletteActive(next);
    list.querySelectorAll('.palette-item')[next]?.scrollIntoView({ block: 'nearest' });
  };

  document.addEventListener('astro:page-load', () => {
    const dataEl = document.getElementById('palette-data');
    const palette = document.getElementById('palette');
    const input = document.getElementById('palette-input') as HTMLInputElement | null;
    const list = document.getElementById('palette-list');
    if (!dataEl || !palette || !input || !list) return;
    try {
      paletteItems = JSON.parse(dataEl.textContent || '[]');
    } catch {
      paletteItems = [];
    }

    input.addEventListener('input', () => renderPalette(input.value));
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); movePaletteActive(1); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); movePaletteActive(-1); }
      else if (event.key === 'Enter') {
        const matched: PaletteItem[] = ((list as any)._matched) || [];
        const item = matched[paletteActive];
        if (item) window.location.href = item.url;
      }
    });
    palette.querySelector('[data-palette-close]')?.addEventListener('click', closePalette);
    document.querySelectorAll('.palette-trigger').forEach((btn) => {
      btn.addEventListener('click', openPalette);
    });
  });

  if (!(window as any).__paletteGlobalBound) {
    (window as any).__paletteGlobalBound = true;
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        const palette = document.getElementById('palette');
        if (palette && !palette.hidden) closePalette();
        else openPalette();
      } else if (event.key === 'Escape') {
        closePalette();
      }
    });
  }
</script>
