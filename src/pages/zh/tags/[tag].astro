---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
  const locale = 'zh';
  const posts = (await getCollection('blog', (entry) => entry.id.startsWith(locale + '/'))).filter(
    (p) => !p.data.draft
  );
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const locale = 'zh';
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`#${tag} — ${SITE_TITLE}`} description={`标签为 #${tag} 的文章`} alternates={false} />
    <style>
      .post-list { list-style: none; margin: 0; padding: 0; }
      .post-item { margin-bottom: 0; }
      .post-link {
        display: block;
        padding: 1.2em 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        transition: padding-left 0.15s ease;
      }
      .post-item:first-child .post-link { border-top: 1px solid var(--border); }
      .post-link:hover {
        padding-left: 1em;
        border-bottom-color: var(--accent);
      }
      .post-title {
        margin: 0 0 0.25rem 0;
        font-size: 1.3em;
        color: var(--text);
        line-height: 1.3;
        font-weight: 600;
        transition: color 0.2s ease;
      }
      .post-desc {
        margin: 0.35rem 0 0 0;
        color: var(--text-muted);
        font-size: 0.9em;
        line-height: 1.5;
      }
      .post-date {
        margin: 0.35rem 0 0 0;
        color: var(--text-muted);
        font-size: 0.8em;
        font-family: var(--font-jetbrains), monospace;
      }
      .post-link:hover .post-title { color: var(--accent); }
      h1 .hash { color: var(--accent); }
      @media (max-width: 720px) {
        .post-link:hover { padding-left: 0.5em; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="animate-in"><span class="hash">#</span>{tag}</h1>
      <ul class="post-list stagger">
        {posts.map((post) => (
          <li class="post-item">
            <a class="post-link" href={`/${locale}/blog/${post.id.replace(locale + '/', '')}`}>
              <h3 class="post-title">{post.data.title}</h3>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
              <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer locale={locale} />
  </body>
</html>
