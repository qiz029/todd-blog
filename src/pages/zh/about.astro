---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { t } from '../../i18n/translations';

const locale = 'zh';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${t('about.heading', locale)} — ${SITE_TITLE}`} description={t('about.meta', locale)} pageType="profile" />
  </head>
  <body>
    <Header />
    <main class="stagger">
      <h1>{t('about.heading', locale)}</h1>
      <p>{t('about.p1', locale)}</p>
      <p>{t('about.p2', locale)}</p>

      <h2>{t('about.what', locale)}</h2>
      <p set:html={t('about.tiktok1', locale)} />
      <p set:html={t('about.tiktok2', locale)} />
      <p set:html={t('about.google', locale)} />

      <h2>{t('about.ai', locale)}</h2>
      <p set:html={t('about.ai1', locale)} />
      <p set:html={t('about.ai2', locale)} />

      <h2>{t('about.building', locale)}</h2>
      <p>{t('about.building.intro', locale)}</p>
      <ul>
        <li><strong><a href="https://paxtech.net" target="_blank" rel="noopener">Pax Tech</a></strong> — {t('about.building.pax', locale)}</li>
        <li><strong><a href="https://dshpluginhub.ai" target="_blank" rel="noopener">DSH Plugin Hub</a></strong> — {t('about.building.pluginHub', locale)}</li>
        <li><strong><a href="https://roundtable.toddzheng.com" target="_blank" rel="noopener">Roundtable</a></strong> — {t('about.building.roundtable', locale)}</li>
      </ul>

      <h2>{t('about.tech', locale)}</h2>
      <ul>
        <li><strong>{t('about.tech.lang', locale)}</strong>: {t('about.tech.lang.v', locale)}</li>
        <li><strong>{t('about.tech.sys', locale)}</strong>: {t('about.tech.sys.v', locale)}</li>
        <li><strong>{t('about.tech.ai', locale)}</strong>: {t('about.tech.ai.v', locale)}</li>
        <li><strong>{t('about.tech.infra', locale)}</strong>: {t('about.tech.infra.v', locale)}</li>
      </ul>

      <h2>{t('about.outside', locale)}</h2>
      <p set:html={t('about.wow', locale)} />
      <p set:html={t('about.cats', locale)} />

      <h2>{t('about.elsewhere', locale)}</h2>
      <ul>
        <li><a href="https://github.com/qiz029">{t('about.gh', locale)}</a></li>
        <li><a href="https://www.linkedin.com/in/toddzheng-024">{t('about.li', locale)}</a></li>
        <li><a href="https://x.com/ShiZheng24517">{t('about.x', locale)} — @ShiZheng24517</a></li>
        <li><a href="https://toddzheng.net/zh/rss.xml">RSS</a></li>
      </ul>
    </main>
    <Footer locale={locale} />
  </body>
</html>
