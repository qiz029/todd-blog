---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import HomeHub from '../../components/HomeHub.astro';
import { t } from '../../i18n/translations';

const locale = 'zh';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={t('home.metaTitle', locale)} description={t('home.intro', locale)} />
  </head>
  <body>
    <Header />
    <main><HomeHub locale={locale} /></main>
    <Footer locale={locale} />
  </body>
</html>
