---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { t } from '../../i18n/translations';
import { getCollection } from 'astro:content';

const locale = 'zh';
const posts = await getCollection('blog', (entry) => entry.id.startsWith(locale + '/'));
const sortedPosts = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={t('home.intro', locale)} />
    <style>
      .hero { margin-bottom: 4em; }
      .hero-geo {
        display: flex;
        gap: 6px;
        margin-bottom: 2em;
      }
      .hero-geo span {
        display: block;
        height: 3px;
      }
      .hero-geo .g1 { width: 48px; background: var(--accent); }
      .hero-geo .g2 { width: 24px; background: var(--accent-amber); }
      .hero-geo .g3 { width: 12px; background: var(--text-muted); }
      .hero h1 {
        font-size: 2.8em;
        margin-bottom: 0.25em;
        letter-spacing: -0.02em;
        animation: rise 0.5s ease-out 0.9s both;
      }
      .hero .sub {
        color: var(--text-muted);
        font-size: 1.1em;
        max-width: 560px;
        line-height: 1.6;
        animation: rise 0.5s ease-out 1.15s both;
      }
      .hero-term {
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.85em;
        color: var(--text-muted);
        margin-bottom: 1em;
      }
      .hero-term .prompt {
        color: var(--accent);
        margin-right: 0.5em;
      }
      .hero-term .cursor {
        color: var(--accent-amber);
        animation: blink 1.1s step-end infinite;
      }
      .hero .sub em {
        color: var(--accent-amber);
        font-style: normal;
      }

      .posts-header {
        display: flex;
        align-items: center;
        gap: 1em;
        margin-bottom: 2em;
      }
      .posts-header h2 {
        margin: 0;
        font-size: 1.25em;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
      }
      .posts-header hr {
        flex: 1;
        margin: 0;
      }

      .post-list { list-style: none; padding: 0; margin: 0; }
      .post-card { margin-bottom: 0; }
      .post-card a {
        display: block;
        padding: 1.2em 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        transition: padding-left 0.15s ease;
      }
      .post-card:first-child a { border-top: 1px solid var(--border); }
      .post-card a:hover {
        padding-left: 1em;
        border-bottom-color: var(--accent);
      }
      .post-title {
        font-size: 1.15em;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.2em;
        transition: color 0.2s ease;
      }
      .post-desc {
        font-size: 0.9em;
        color: var(--text-muted);
        margin-bottom: 0.3em;
        line-height: 1.5;
      }
      .post-date {
        font-size: 0.8em;
        color: var(--text-muted);
        font-family: var(--font-jetbrains), monospace;
      }
      .post-card a:hover .post-title { color: var(--accent); }

      .empty { color: var(--text-muted); font-style: italic; }

      @media (max-width: 720px) {
        .hero h1 { font-size: 2em; }
        .post-card a:hover { padding-left: 0.5em; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-geo">
          <span class="g1"></span>
          <span class="g2"></span>
          <span class="g3"></span>
        </div>
        <div class="hero-term" aria-hidden="true">
          <span class="prompt">~ $</span><span id="term-cmd">whoami</span><span class="cursor">▌</span>
        </div>
        <h1>{t('home.heading', locale)}</h1>
        <p class="sub">{t('home.intro', locale)}</p>
      </section>

      <section>
        <div class="posts-header animate-in" style="animation-delay: 1.3s">
          <h2>{t('home.writing', locale)}</h2>
          <hr />
        </div>
        {
          sortedPosts.length === 0 ? (
            <p class="empty">{t('home.empty', locale)}</p>
          ) : (
            <ul class="post-list">
              {sortedPosts.map((post, i) => (
                <li class="post-card animate-in" style={`animation-delay: ${1.4 + i * 0.06}s`}>
                  <a href={`/${locale}/blog/${post.id.replace(locale + '/', '')}`}>
                    <div class="post-title">{post.data.title}</div>
                    {post.data.description && <div class="post-desc">{post.data.description}</div>}
                    <div class="post-date">
                      {post.data.pubDate.toLocaleDateString('zh-CN', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </main>
    <Footer locale={locale} />
    <script>
      // Terminal-style typewriter for the hero. Re-runs on every page load
      // (including ClientRouter navigations) via astro:page-load.
      document.addEventListener('astro:page-load', () => {
        const cmd = document.getElementById('term-cmd');
        if (!cmd) return;
        const text = 'whoami';
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          cmd.textContent = text;
          return;
        }
        cmd.textContent = '';
        let i = 0;
        const timer = setInterval(() => {
          cmd.textContent = text.slice(0, ++i);
          if (i >= text.length) clearInterval(timer);
        }, 90);
      });
    </script>
  </body>
</html>
