---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

const locale = Astro.currentLocale || 'en';
const posts = (await getCollection('blog', (entry) => entry.id.startsWith(locale + '/')))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
    if (dateDiff !== 0) return dateDiff;
    return b.id.localeCompare(a.id);
  });
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} />
    <style>
      main { width: 720px; }
      .post-list { list-style-type: none; margin: 0; padding: 0; }
      .post-item { margin-bottom: 2.5rem; }
      .post-link { text-decoration: none; display: block; }
      .post-title { margin: 0 0 0.25rem 0; font-size: 1.563em; color: rgb(var(--black)); line-height: 1.3; }
      .post-desc { margin: 0.35rem 0 0 0; color: rgb(var(--gray)); font-size: 0.9em; line-height: 1.5; }
      .post-date { margin: 0.15rem 0 0 0; color: rgb(var(--gray)); font-size: 0.85em; }
      .post-link:hover .post-title { color: var(--accent); }
      @media (max-width: 720px) {
        main { width: 100%; padding: 1em; }
        .post-item { margin-bottom: 2rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Blog</h1>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a class="post-link" href={`/${locale}/blog/${post.id.replace(locale + '/', '')}`}>
              <h3 class="post-title">{post.data.title}</h3>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
              <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer locale={locale} />
  </body>
</html>
