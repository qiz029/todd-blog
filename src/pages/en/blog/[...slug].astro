---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { localePosts, postNav, postUrl, readingStats, seriesContext } from '../../../lib/blog';

export async function getStaticPaths() {
  const locale = 'en';
  const posts = await getCollection(
    'blog',
    (entry) => entry.id.startsWith(locale + '/') && !entry.data.draft
  );
  return posts.map((post) => ({
    params: { slug: post.id.replace(locale + '/', '') },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const locale = 'en';
const post = Astro.props;
const { Content, headings } = await render(post);

const sorted = localePosts(await getCollection('blog'), locale);
const { older, newer, related } = postNav(sorted, post);
const toLink = (p: CollectionEntry<'blog'>) => ({
  title: p.data.title,
  href: postUrl(p, locale),
  description: p.data.description,
});
const series = seriesContext(await getCollection('series'), sorted, post, locale);
const seriesInfo = series && {
  title: series.entry.data.title,
  href: series.href,
  index: series.index,
  total: series.total,
  prev: series.prev && toLink(series.prev),
  next: series.next && toLink(series.next),
  parts: series.posts.map((p) => ({ ...toLink(p), current: p.id === post.id })),
};
---

<BlogPost
  {...post.data}
  id={post.id}
  locale={locale}
  headings={headings}
  stats={readingStats(post.body ?? '')}
  older={older && toLink(older)}
  newer={newer && toLink(newer)}
  related={related.map(toLink)}
  seriesInfo={seriesInfo}
>
  <Content />
</BlogPost>
