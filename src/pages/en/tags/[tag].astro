---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { t } from '../../../i18n/translations';
import { localePosts, postUrl, tagGroups } from '../../../lib/blog';
import { MIN_INDEXED_TAG_POSTS } from '../../../lib/tags';

export async function getStaticPaths() {
  const locale = 'en';
  const posts = localePosts(await getCollection('blog'), locale);
  return tagGroups(posts).map((group) => ({
    params: { tag: group.slug },
    props: { name: group.name, posts: group.posts },
  }));
}

const locale = 'en';
const { name, posts } = Astro.props;
const description = t('tags.tagMeta', locale)
  .replace('{tag}', name)
  .replace('{n}', String(posts.length));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`#${name} — ${SITE_TITLE}`}
      description={description}
      alternates={false}
      noindex={posts.length < MIN_INDEXED_TAG_POSTS}
    />
    <style>
      .post-list { list-style: none; margin: 0; padding: 0; }
      .post-item { margin-bottom: 0; }
      .post-link {
        display: block;
        padding: 1.2em 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        transition: padding-left 0.15s ease;
      }
      .post-item:first-child .post-link { border-top: 1px solid var(--border); }
      .post-link:hover {
        padding-left: 1em;
        border-bottom-color: var(--accent);
      }
      .post-title {
        margin: 0 0 0.25rem 0;
        font-size: 1.3em;
        color: var(--text);
        line-height: 1.3;
        font-weight: 600;
        transition: color 0.2s ease;
      }
      .post-desc {
        margin: 0.35rem 0 0 0;
        color: var(--text-muted);
        font-size: 0.9em;
        line-height: 1.5;
      }
      .post-date {
        margin: 0.35rem 0 0 0;
        color: var(--text-muted);
        font-size: 0.8em;
        font-family: var(--font-jetbrains), monospace;
      }
      .post-link:hover .post-title { color: var(--accent); }
      h1 .hash { color: var(--accent); }
      .back {
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.85em;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .back:hover { color: var(--accent); }
      @media (max-width: 720px) {
        .post-link:hover { padding-left: 0.5em; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <p class="animate-in"><a class="back" href={`/${locale}/tags/`}>← {t('tags.allTags', locale)}</a></p>
      <h1 class="animate-in"><span class="hash">#</span>{name}</h1>
      <ul class="post-list stagger">
        {posts.map((post) => (
          <li class="post-item">
            <a class="post-link" href={postUrl(post, locale)}>
              <h3 class="post-title">{post.data.title}</h3>
              {post.data.description && <p class="post-desc">{post.data.description}</p>}
              <p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer locale={locale} />
  </body>
</html>
