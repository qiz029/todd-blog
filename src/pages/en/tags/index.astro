---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { t } from '../../../i18n/translations';
import { localePosts, tagCounts } from '../../../lib/blog';

const locale = Astro.currentLocale || 'en';
const posts = localePosts(await getCollection('blog'), locale);
const tags = tagCounts(posts);
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <BaseHead title={`${t('tags.heading', locale)} — ${SITE_TITLE}`} />
    <style>
      .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7em;
        margin-top: 2em;
      }
      .tag-cloud a {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45em;
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.9em;
        color: var(--text);
        text-decoration: none;
        padding: 0.4em 0.85em;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 4px;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .tag-cloud a:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
      .tag-cloud .count {
        font-size: 0.8em;
        color: var(--text-muted);
      }
      .tag-cloud .hash { color: var(--accent); }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="animate-in">{t('tags.heading', locale)}</h1>
      <div class="tag-cloud stagger">
        {tags.map(([tag, count]) => (
          <a href={`/${locale}/tags/${tag}/`}>
            <span><span class="hash">#</span>{tag}</span>
            <span class="count">{count}</span>
          </a>
        ))}
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
