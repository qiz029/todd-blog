---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`About — ${SITE_TITLE}`} />
  </head>
  <body>
    <Header />
    <main>
      <h1>About</h1>
      <p>
        I'm Todd Zheng (郑秋石), a software engineer and systems thinker. I
        live with my wife Ellen and four cats — 布丁, boba, judy, and eevee
        (affectionately known as 小面包).
      </p>
      <p>
        I spend most of my time thinking about compilers, distributed systems,
        and how to make software that doesn't collapse under its own weight. I
        believe code readability is the most underrated property in software
        engineering, and I'm on a quiet crusade to prove it matters.
      </p>
      <p>
        When I'm not coding, I'm probably playing WoW, reading about WoW, or
        analyzing WoW logs. I have ADHD and anxiety — the blog exists partly
        because writing things down helps me think.
      </p>
      <p>
        This site is hand-built with Astro and lives on Cloudflare Pages. No
        tracking, no ads, no bullshit.
      </p>

      <h2>Elsewhere</h2>
      <ul>
        <li><a href="https://github.com/qiz029">GitHub</a></li>
        <li><a href="https://toddzheng.net/rss.xml">RSS</a></li>
      </ul>
    </main>
    <Footer />
  </body>
</html>
