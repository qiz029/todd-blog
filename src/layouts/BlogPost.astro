---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n/translations';
import 'katex/dist/katex.min.css';

type Props = CollectionEntry<'blog'>['data'] & { id: string; locale?: string };

const { id, title, description, pubDate, updatedDate, heroImage, tags = [], locale = 'en' } =
  Astro.props;
---

<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={`/og/${id}.png`}
      article={{ pubDate, updatedDate, tags }}
    />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 4px;
      }
      .prose {
        width: 800px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: var(--text);
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
        color: var(--text);
      }
      .date {
        margin-bottom: 0.5em;
        color: var(--text-muted);
        font-family: monospace;
        font-size: 0.85em;
      }
      .last-updated-on {
        font-style: italic;
      }
      .title hr {
        margin-top: 1.5em;
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5em;
        margin-top: 1em;
      }
      .tags a {
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.75em;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.25em 0.6em;
        border: 1px solid var(--border);
        border-radius: 4px;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .tags a:hover {
        color: var(--accent);
        border-color: var(--accent);
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt={title} />
          </div>
        )}
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    {t('blog.updated', locale)} <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            {tags.length > 0 && (
              <div class="tags">
                {tags.map((tag) => (
                  <a href={`/${locale}/tags/${tag}/`}>#{tag}</a>
                ))}
              </div>
            )}
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer locale={locale} />
  </body>
</html>
