---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n/translations';
import { postUrl, readingStats } from '../lib/blog';

interface Props {
  locale: string;
  entry: CollectionEntry<'series'>;
  slug: string;
  posts: CollectionEntry<'blog'>[];
  /** Whether the same series exists in the other locale (drives hreflang). */
  alternates: boolean;
}
const { locale, entry, slug, posts, alternates } = Astro.props;
const { Content } = await render(entry);
const hasIntro = (entry.body ?? '').trim().length > 0;
const { title, description, status, cover, upNext } = entry.data;

const count = (n: number) => t('series.count', locale).replace('{n}', String(n));
const totalMinutes = posts.reduce((sum, p) => sum + readingStats(p.body ?? '').minutes, 0);
const updated = posts.reduce<Date | undefined>((latest, p) => {
  const d = p.data.updatedDate ?? p.data.pubDate;
  return !latest || d > latest ? d : latest;
}, undefined);
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={`/og/${locale}/series/${slug}.png`}
      alternates={alternates}
    />
    <style>
      .back {
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.85em;
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .back:hover { color: var(--accent); }

      /* ── Cover block ── */
      .cover {
        margin-top: 1em;
        padding: 2.25em 2em 2em;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-left: 4px solid var(--accent);
        border-radius: 6px;
      }
      .cover-image { margin: -2.25em -2em 1.75em -2em; }
      .cover-image img {
        display: block;
        width: 100%;
        border-radius: 6px 6px 0 0;
      }
      .kicker {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.8em;
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.75em;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 1em;
      }
      .kicker .label { color: var(--accent); }
      .status {
        padding: 0.1em 0.6em;
        border: 1px solid var(--border);
        border-radius: 999px;
      }
      .status.ongoing { color: var(--accent-amber); border-color: var(--accent-amber); }
      .cover h1 {
        margin: 0 0 0.4em 0;
        font-size: 2.4em;
        line-height: 1.2;
      }
      .cover .lede {
        margin: 0;
        color: var(--text-muted);
        font-size: 1.05em;
        line-height: 1.6;
      }
      .cover-intro {
        margin-top: 1.25em;
        color: var(--text);
        font-size: 0.95em;
        line-height: 1.75;
      }
      .cover-intro :global(p:last-child) { margin-bottom: 0; }
      .cover-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1em;
        margin-top: 1.75em;
      }
      .start {
        display: inline-block;
        padding: 0.55em 1.2em;
        background: var(--accent);
        color: #fff;
        font-weight: 600;
        font-size: 0.9em;
        border-radius: 4px;
        text-decoration: none;
        transition: background 0.2s ease;
      }
      .start:hover { background: #cc2418; color: #fff; }
      .cover-updated {
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.75em;
        color: var(--text-muted);
      }

      /* ── Reading order ── */
      .order-header {
        display: flex;
        align-items: center;
        gap: 1em;
        margin: 3em 0 0.5em;
      }
      .order-header h2 {
        margin: 0;
        font-size: 1em;
        font-family: var(--font-jetbrains), monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }
      .order-header hr { flex: 1; margin: 0; }
      .parts { list-style: none; margin: 0; padding: 0; }
      .part { border-bottom: 1px solid var(--border); }
      .part a {
        display: grid;
        grid-template-columns: 3.2em minmax(0, 1fr);
        column-gap: 0.5em;
        padding: 1.2em 0;
        text-decoration: none;
        transition: padding-left 0.15s ease;
      }
      .part a:hover { padding-left: 0.8em; }
      .part:hover { border-bottom-color: var(--accent); }
      .part .n {
        font-family: var(--font-jetbrains), monospace;
        font-size: 1.1em;
        color: var(--accent);
        line-height: 1.5;
      }
      .part .p-title {
        margin: 0 0 0.25rem 0;
        font-size: 1.25em;
        color: var(--text);
        line-height: 1.3;
        font-weight: 600;
        transition: color 0.2s ease;
      }
      .part a:hover .p-title { color: var(--accent); }
      .part .p-desc {
        margin: 0.3rem 0 0 0;
        color: var(--text-muted);
        font-size: 0.9em;
        line-height: 1.5;
      }
      .part .p-date {
        margin: 0.35rem 0 0 0;
        color: var(--text-muted);
        font-size: 0.78em;
        font-family: var(--font-jetbrains), monospace;
      }
      .up-next {
        display: grid;
        grid-template-columns: 3.2em minmax(0, 1fr);
        column-gap: 0.5em;
        padding: 1.2em 0;
        color: var(--text-muted);
        border-bottom: 1px dashed var(--border);
      }
      .up-next .n {
        font-family: var(--font-jetbrains), monospace;
        font-size: 1.1em;
        opacity: 0.5;
      }
      .up-next .label {
        font-family: var(--font-jetbrains), monospace;
        font-size: 0.72em;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        display: block;
        margin-bottom: 0.2em;
      }
      .empty { color: var(--text-muted); margin-top: 1.5em; }
      @media (max-width: 720px) {
        .cover { padding: 1.5em 1.25em; }
        .cover-image { margin: -1.5em -1.25em 1.25em -1.25em; }
        .cover h1 { font-size: 1.9em; }
        .part a:hover { padding-left: 0.4em; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <p class="animate-in"><a class="back" href={`/${locale}/series/`}>← {t('series.allSeries', locale)}</a></p>

      <section class="cover animate-in">
        {cover && (
          <div class="cover-image">
            {typeof cover === 'string' ? (
              <img width={1020} height={510} src={cover} alt="" />
            ) : (
              <Image width={1020} height={510} src={cover} alt="" />
            )}
          </div>
        )}
        <div class="kicker">
          <span class="label">{t('series.heading', locale)}</span>
          <span class:list={['status', status]}>{t(`series.${status}`, locale)}</span>
          <span>{count(posts.length)}</span>
          {posts.length > 0 && (
            <span>{t('series.totalTime', locale).replace('{min}', String(totalMinutes))}</span>
          )}
        </div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {hasIntro && (
          <div class="cover-intro">
            <Content />
          </div>
        )}
        <div class="cover-actions">
          {posts[0] && <a class="start" href={postUrl(posts[0], locale)}>{t('series.start', locale)} →</a>}
          {updated && <span class="cover-updated">{t('series.updated', locale)} <FormattedDate date={updated} /></span>}
        </div>
      </section>

      <div class="order-header animate-in">
        <h2>{t('series.readingOrder', locale)}</h2>
        <hr />
      </div>
      {posts.length === 0 ? (
        <p class="empty">{t('series.empty', locale)}</p>
      ) : (
        <ol class="parts stagger">
          {posts.map((post, i) => (
            <li class="part">
              <a href={postUrl(post, locale)}>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="p-title">{post.data.title}</h3>
                  {post.data.description && <p class="p-desc">{post.data.description}</p>}
                  <p class="p-date"><FormattedDate date={post.data.pubDate} /></p>
                </div>
              </a>
            </li>
          ))}
          {status === 'ongoing' && upNext && (
            <li class="up-next">
              <span class="n">{String(posts.length + 1).padStart(2, '0')}</span>
              <div>
                <span class="label">{t('series.upNext', locale)}</span>
                {upNext}
              </div>
            </li>
          )}
        </ol>
      )}
    </main>
    <Footer locale={locale} />
  </body>
</html>
